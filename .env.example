# Projeto NOVO e exclusivo do DCS HUB; NÃO reutilize BUSCA AUTORIDADE.
# Copie para .env local (ignorado pelo Git). Nunca publique chaves secretas.
# homologacao = login Supabase obrigatório. Não há fallback para contas fictícias.
VITE_DCS_MODE=homologacao
VITE_SUPABASE_URL=https://SEU-PROJETO-DCS.supabase.co
# Chave pública sb_publishable_... do próprio projeto DCS HUB. NÃO use sb_secret_ / service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICAVEL
